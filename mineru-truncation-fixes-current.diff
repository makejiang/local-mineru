+def is_truncated_by_length(result) -> bool:
+    """判断一次生成是否因达到 ``max_new_tokens`` 上限而被截断。
+
+    这是判断截断的**权威依据**——不依赖任何输出文本的启发式特征：
+
+    - 批处理路径：``GenerationOutput.finish_reason``
+    - 非批处理路径：``DecodedResults.finish_reasons``（列表）
+
+    两者都以 ``GenerationFinishReason.LENGTH`` 表示"因长度停止"，
+    ``STOP`` 表示模型正常输出到结束符。
+    """
+    reason = getattr(result, "finish_reason", None)
+    if reason is None:
+        reasons = getattr(result, "finish_reasons", None)
+        if reasons:
+            reason = reasons[0]
+    if reason is None:
+        return False
+
+    enum = getattr(ov_genai, "GenerationFinishReason", None)
+    if enum is not None and hasattr(enum, "LENGTH"):
+        try:
+            return reason == enum.LENGTH
+        except Exception:
+            pass
+    return getattr(reason, "name", "") == "LENGTH"
 
 
